ório · &lt;font color='#82b366'&gt;■&lt;/font&gt; pessoas · &lt;font color='#d79b00'&gt;■&lt;/font&gt; demanda · &lt;font color='#9673a6'&gt;■&lt;/font&gt; trabalho de campo" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="54" y="1106" width="500" height="96" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>